{
  "$comment": "终末地 HUD 皮肤设计 token（M0）。色值取自终末地官网 official-v4 前端 CSS 全量统计，字体取自官网 @font-face 实际文件。",
  "color": {
    "base": {
      "ef-black-900": "#0E0E0E",
      "ef-black-800": "#131315",
      "ef-black-700": "#191919",
      "ef-black-600": "#1F1F22"
    },
    "line": {
      "ef-gray-500": "#35373C",
      "ef-gray-400": "#424242",
      "ef-gray-350": "#3C3C3C"
    },
    "text": {
      "ef-white": "#FFFFFF",
      "ef-white-soft": "#E6E6E6",
      "ef-white-dim": "#FAFAFA",
      "ef-gray-050": "#D9D9D9",
      "ef-gray-100": "#B2B2B2",
      "ef-gray-200": "#999999",
      "ef-gray-300": "#666666"
    },
    "accent": {
      "ef-accent": "#FFFA00",
      "ef-accent-hi": "#FFFF21",
      "ef-accent-mid": "#FFF000",
      "ef-accent-lo": "#E6DE01",
      "ef-accent-deep": "#EFE701"
    },
    "signal": {
      "ef-magenta": "#FF1AAC",
      "ef-mint": "#00FFA2"
    },
    "alpha": {
      "ef-line-1": "rgba(255,255,255,.10)",
      "ef-line-2": "rgba(255,255,255,.16)",
      "ef-line-3": "rgba(255,255,255,.28)",
      "ef-grid": "rgba(255,255,255,.035)",
      "ef-scrim": "rgba(0,0,0,.65)"
    }
  },
  "depth": {
    "d0-base": {
      "surface": "#0E0E0E",
      "border": "none",
      "shadow": "none",
      "parallaxK": 0,
      "usage": "页面底 / 背景网格"
    },
    "d1-plane": {
      "surface": "#191919",
      "border": "1px solid rgba(255,255,255,.10)",
      "shadow": "none",
      "parallaxK": 1,
      "usage": "主面板 / 侧栏 / 详情列"
    },
    "d2-float": {
      "surface": "#1F1F22",
      "border": "1px solid rgba(255,255,255,.16)",
      "shadow": "0 2px 12px rgba(0,0,0,.5)",
      "parallaxK": 3,
      "usage": "卡片 / 消息块 / 工具调用"
    },
    "d3-hover": {
      "surface": "rgba(25,25,25,.92)",
      "border": "1px solid #FFFA00",
      "shadow": "0 12px 40px rgba(0,0,0,.65)",
      "parallaxK": 6,
      "usage": "弹窗 / 浮层 / 下拉 / 设置"
    }
  },
  "typography": {
    "display-xl": {
      "family": "NovecentoWide-Bold",
      "size": "28px",
      "lineHeight": "32px",
      "tracking": ".02em",
      "transform": "uppercase"
    },
    "display-l": {
      "family": "NovecentoWide-DemiBold",
      "size": "18px",
      "lineHeight": "22px",
      "tracking": ".06em",
      "transform": "uppercase"
    },
    "section-title": {
      "family": "NovecentoWide-DemiBold",
      "size": "13px",
      "lineHeight": "16px",
      "tracking": ".14em",
      "transform": "uppercase"
    },
    "body": {
      "family": "Gilroy-Medium",
      "size": "14px",
      "lineHeight": "22px",
      "tracking": "0",
      "transform": "none"
    },
    "body-light": {
      "family": "Gilroy-Light",
      "size": "13px",
      "lineHeight": "20px",
      "tracking": ".01em",
      "transform": "none"
    },
    "data": {
      "family": "SpaceGrotesk",
      "size": "13px",
      "lineHeight": "16px",
      "tracking": ".04em",
      "transform": "none",
      "feature": "tabular-nums"
    },
    "micro-label": {
      "family": "Gilroy-Medium",
      "size": "10px",
      "lineHeight": "12px",
      "tracking": ".16em",
      "transform": "uppercase"
    },
    "alert": {
      "family": "ProtestStrike-Regular",
      "size": "20px",
      "lineHeight": "24px",
      "tracking": ".06em",
      "transform": "uppercase"
    },
    "code": {
      "family": "SF Mono, JetBrains Mono, Consolas",
      "size": "12.5px",
      "lineHeight": "20px",
      "tracking": "0",
      "transform": "none"
    }
  },
  "shape": {
    "cornerCut": "8px",
    "cornerCutSm": "5px",
    "radius": "0px",
    "bracket": "12x12 L 形角标",
    "grid": "32px 淡线网格",
    "hazard": "45° / 8px 周期黄黑条纹",
    "scanline": "1px 线 / 4px 周期 / 3% 透明度"
  },
  "motion": {
    "ef-dur-fast": "100ms",
    "ef-dur": "200ms",
    "ef-dur-slow": "300ms",
    "ef-dur-hud": "420ms",
    "ef-ease": "cubic-bezier(.4,0,.2,1)",
    "ef-ease-hud": "cubic-bezier(.16,1,.3,1)",
    "ds-native": {
      "ds-ease-in-out": "cubic-bezier(0.4,0,0.2,1)",
      "ds-transition-duration": "0.2s",
      "ds-transition-duration-fast": "0.1s",
      "ds-transition-duration-slow": "0.3s"
    }
  },
  "layout": {
    "sidebar": {
      "default": 280,
      "min": 264,
      "max": 420,
      "collapsed": 56,
      "inlinePadding": 12,
      "verticalPadding": 6
    },
    "details": {
      "default": 360,
      "min": 300,
      "max": 520
    },
    "centerMin": 640,
    "overlayLayer": {
      "position": "absolute",
      "inset": 0,
      "zIndex": 20,
      "pointerEvents": "none"
    }
  }
}